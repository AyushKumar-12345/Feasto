# ==============================================================================
# Feasto - Environment Configuration Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit the real .env file or expose backend secrets to git.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Host Configuration (Backend)
# ------------------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
# Allowed origins for CORS (comma-separated or single URL)
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174

# ------------------------------------------------------------------------------
# 2. Database (MongoDB Atlas or Local MongoDB)
# ------------------------------------------------------------------------------
# For local Docker Compose development: mongodb://mongodb:27017/feasto
# For MongoDB Atlas production: mongodb+srv://<username>:<password>@cluster0.mongodb.net/feasto?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://your_username:your_password@cluster.mongodb.net/feasto

# ------------------------------------------------------------------------------
# 3. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# A secure, random string used to sign JSON Web Tokens
JWT_SECRET=your_jwt_secret_minimum_32_characters_long

# Initial Administrator account credentials
ADMIN_EMAIL=admin@feasto.com
ADMIN_PASSWORD=your_secure_admin_password

# ------------------------------------------------------------------------------
# 4. Media Storage (Cloudinary)
# Obtain from https://cloudinary.com/console
# ------------------------------------------------------------------------------
CLOUDINARY_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_SECRET_KEY=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 5. Payment Gateway (Razorpay)
# Obtain test/live keys from https://dashboard.razorpay.com/app/keys
# ------------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ------------------------------------------------------------------------------
# 6. AI Assistant (Google Gemini 3.0)
# Obtain free API key from https://aistudio.google.com/app/apikey
# ------------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# 7. Frontend Client Build Variables (Vite Public Variables)
# NOTE: VITE_* variables are embedded into public browser bundles.
# NEVER put secrets, private keys, or passwords in VITE_* variables.
# ------------------------------------------------------------------------------
VITE_BACKEND_URL=http://localhost:4000
VITE_ADMIN_URL=http://localhost:5174
VITE_FRONTEND_URL=http://localhost:5173
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id
# Formspree Form ID for Contact Us inquiries (https://formspree.io/)
VITE_FORMSPREE_FORM_ID=your_formspree_form_id

